{
  "manifest_version": 3,
  "name": "YT AI Filter",
  "version": "0.2.0",
  "description": "유튜브에서 AI 생성 영상을 숨기거나 흐리게 처리합니다. (AI 라벨 감지 + 채널 차단 + 제목 키워드)",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT AI Filter"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
